"""Standardized configuration facade for __APP_COMMAND__.

This CLI reads and writes only native project configuration stores declared in the static contract.
It does not create a shadow configuration store and is not imported by the application runtime.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
import tempfile
from pathlib import Path
from typing import Any

CLI_VERSION = "1.0.0"
DEFAULT_CONTRACT = Path("__CONTRACT_PATH__")
CONFIG_COMMANDS = {
    "modules", "describe", "get", "show", "validate", "capabilities", "coverage",
    "agent-context", "prepare-change", "apply-plan", "set", "unset", "secret", "wizard",
}


def emit(command: str, *, status="success", changed=False, result=None, artifacts=None, warnings=None, errors=None):
    payload = {
        "status": status,
        "command": command,
        "changed": changed,
        "result": result or {},
        "artifacts": artifacts or [],
        "warnings": warnings or [],
        "errors": errors or [],
    }
    print(json.dumps(payload, ensure_ascii=False, sort_keys=True, indent=2))


def stable_hash(value: Any) -> str:
    raw = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return f"sha256:{hashlib.sha256(raw.encode('utf-8')).hexdigest()}"


def atomic_write(path: Path, text: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_name, path)
    except Exception:
        try:
            os.unlink(temp_name)
        except OSError:
            pass
        raise


def safe_native_path(root: Path, raw_path: str) -> Path:
    relative = Path(raw_path)
    if relative.is_absolute():
        raise ValueError(f"native path must be repository-relative: {raw_path}")
    root_resolved = root.resolve()
    candidate = (root_resolved / relative).resolve()
    try:
        candidate.relative_to(root_resolved)
    except ValueError as exc:
        raise ValueError(f"native path escapes repository root: {raw_path}") from exc
    return candidate


def load_contract(path: Path):
    contract = json.loads(path.read_text(encoding="utf-8"))
    if contract.get("schema_version") != 1:
        raise ValueError("unsupported contract schema_version")
    if not isinstance(contract.get("application"), dict) or not isinstance(contract.get("modules"), list):
        raise ValueError("invalid configuration contract")
    for _, field in fields(contract):
        binding = field.get("binding")
        if not isinstance(binding, dict) or not isinstance(binding.get("adapter"), str):
            raise ValueError(f"invalid binding for {field.get('key', '<unknown>')}")
        if binding.get("adapter") in {"dotenv", "json"} and not isinstance(binding.get("path"), str):
            raise ValueError(f"native path required for {field.get('key', '<unknown>')}")
    return contract


def fields(contract):
    for module in contract.get("modules", []):
        for field in module.get("fields", []):
            yield module, field


def field_by_key(contract, key):
    for module, field in fields(contract):
        if field.get("key") == key:
            return module, field
    raise KeyError(key)


def coerce(field, raw):
    kind = field.get("type")
    if kind == "boolean":
        if isinstance(raw, bool):
            return raw
        low = str(raw).strip().lower()
        if low in {"true", "1", "yes", "on"}:
            return True
        if low in {"false", "0", "no", "off"}:
            return False
        raise ValueError("expected boolean")
    if kind == "integer":
        return int(raw)
    if kind == "number":
        return float(raw)
    if kind in {"array", "object"}:
        return raw if isinstance(raw, (list, dict)) else json.loads(raw)
    return str(raw)


def validate_value(field, value):
    rules = field.get("validation", {})
    if "choices" in rules and value not in rules["choices"]:
        raise ValueError(f"expected one of {rules['choices']}")
    if "minimum" in rules and value < rules["minimum"]:
        raise ValueError(f"minimum is {rules['minimum']}")
    if "maximum" in rules and value > rules["maximum"]:
        raise ValueError(f"maximum is {rules['maximum']}")
    if "min_length" in rules and len(value) < rules["min_length"]:
        raise ValueError(f"minimum length is {rules['min_length']}")
    if "max_length" in rules and len(value) > rules["max_length"]:
        raise ValueError(f"maximum length is {rules['max_length']}")
    if "pattern" in rules and not re.fullmatch(rules["pattern"], str(value)):
        raise ValueError("value does not match required pattern")


def dotenv_read(path: Path, native_key: str):
    if not path.exists():
        return None, False
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() == native_key:
            return value.strip(), True
    return None, False


def dotenv_write(path: Path, native_key: str, value, unset=False):
    lines = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
    output = []
    found = False
    for line in lines:
        if not line.lstrip().startswith("#") and "=" in line and line.split("=", 1)[0].strip() == native_key:
            found = True
            if not unset:
                output.append(f"{native_key}={serialize_native(value)}")
        else:
            output.append(line)
    if not found and not unset:
        output.append(f"{native_key}={serialize_native(value)}")
    atomic_write(path, "\n".join(output) + ("\n" if output else ""))


def json_get(data, dotted):
    current = data
    for part in dotted.split("."):
        current = current[part]
    return current


def json_set(data, dotted, value, unset=False):
    parts = dotted.split(".")
    current = data
    for part in parts[:-1]:
        child = current.get(part)
        if child is None:
            child = {}
            current[part] = child
        if not isinstance(child, dict):
            raise ValueError(f"native JSON path crosses non-object at {part}")
        current = child
    if unset:
        current.pop(parts[-1], None)
    else:
        current[parts[-1]] = value


def serialize_native(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (list, dict)):
        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    return str(value)


def native_artifact(root: Path, field):
    binding = field["binding"]
    if binding["adapter"] in {"dotenv", "json"}:
        return safe_native_path(root, binding["path"])
    return None


def read_native(root: Path, field):
    binding = field["binding"]
    adapter = binding["adapter"]
    if adapter == "env":
        key = binding["native_key"]
        return os.getenv(key), key in os.environ, {"adapter": "env", "native_key": key}
    if adapter == "dotenv":
        path = safe_native_path(root, binding["path"])
        value, exists = dotenv_read(path, binding["native_key"])
        return value, exists, {"adapter": "dotenv", "path": str(path), "native_key": binding["native_key"]}
    if adapter == "json":
        path = safe_native_path(root, binding["path"])
        if not path.exists():
            return None, False, {"adapter": "json", "path": str(path), "json_path": binding["json_path"]}
        data = json.loads(path.read_text(encoding="utf-8"))
        try:
            return json_get(data, binding["json_path"]), True, {"adapter": "json", "path": str(path), "json_path": binding["json_path"]}
        except (KeyError, TypeError):
            return None, False, {"adapter": "json", "path": str(path), "json_path": binding["json_path"]}
    raise ValueError(f"adapter {adapter} requires a project-native custom adapter")


def write_native(root: Path, field, value=None, unset=False):
    binding = field["binding"]
    adapter = binding["adapter"]
    if adapter == "dotenv":
        path = safe_native_path(root, binding["path"])
        dotenv_write(path, binding["native_key"], value, unset=unset)
        return str(path)
    if adapter == "json":
        path = safe_native_path(root, binding["path"])
        data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
        json_set(data, binding["json_path"], value, unset=unset)
        atomic_write(path, json.dumps(data, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
        return str(path)
    raise ValueError(f"adapter {adapter} is not writable by the standard fallback")


def contract_fingerprint(contract):
    return stable_hash(contract)


def state_fingerprint(root: Path, contract, keys):
    state = []
    for key in sorted(set(keys)):
        _, field = field_by_key(contract, key)
        value, exists, source = read_native(root, field)
        state.append({"key": key, "exists": exists, "value": "<redacted>" if field.get("secret") else value, "source": source})
    return stable_hash(state)


def parse_assignments(items):
    result = []
    for item in items:
        if "=" not in item:
            raise ValueError(f"expected key=value: {item}")
        key, raw = item.split("=", 1)
        result.append((key, raw))
    return result


def build_plan(root, contract, assignments):
    changes = []
    keys = []
    seen = set()
    for key, raw in assignments:
        if key in seen:
            raise ValueError(f"duplicate change key: {key}")
        seen.add(key)
        _, field = field_by_key(contract, key)
        if not field.get("writable"):
            raise ValueError(f"field is read-only: {key}")
        if field.get("secret"):
            raise ValueError(f"secret field requires `config secret set {key} --stdin`")
        value = coerce(field, raw)
        validate_value(field, value)
        current, exists, source = read_native(root, field)
        typed_current = coerce(field, current) if exists else None
        changes.append({"key": key, "from": typed_current, "to": value, "source": source, "effects": field.get("effects", {})})
        keys.append(key)
    core = {
        "schema_version": 1,
        "contract_fingerprint": contract_fingerprint(contract),
        "changes": changes,
        "state_fingerprint": state_fingerprint(root, contract, keys),
    }
    return {**core, "plan_hash": stable_hash(core)}


def validate_plan(root, contract, plan, expected_hash):
    if not isinstance(plan, dict) or plan.get("schema_version") != 1:
        raise ValueError("invalid plan schema")
    changes = plan.get("changes")
    if not isinstance(changes, list) or not changes:
        raise ValueError("plan must contain changes")
    core = {key: plan.get(key) for key in ("schema_version", "contract_fingerprint", "changes", "state_fingerprint")}
    calculated_hash = stable_hash(core)
    if plan.get("plan_hash") != calculated_hash or expected_hash != calculated_hash:
        raise ValueError("plan hash mismatch; prepare and approve the exact plan again")
    if plan.get("contract_fingerprint") != contract_fingerprint(contract):
        raise ValueError("configuration contract changed; prepare again")
    seen = set()
    canonical = []
    for change in changes:
        if not isinstance(change, dict) or not isinstance(change.get("key"), str):
            raise ValueError("invalid plan change")
        key = change["key"]
        if key in seen:
            raise ValueError(f"duplicate change key: {key}")
        seen.add(key)
        _, field = field_by_key(contract, key)
        if not field.get("writable") or field.get("secret"):
            raise ValueError(f"plan contains unsupported field: {key}")
        value = coerce(field, change.get("to"))
        validate_value(field, value)
        canonical.append({**change, "to": value})
    return canonical, calculated_hash


def capture_snapshots(root, contract, changes):
    snapshots = {}
    for change in changes:
        _, field = field_by_key(contract, change["key"])
        path = native_artifact(root, field)
        if path is not None and path not in snapshots:
            snapshots[path] = path.read_bytes() if path.exists() else None
    return snapshots


def restore_snapshots(snapshots):
    for path, content in snapshots.items():
        if content is None:
            path.unlink(missing_ok=True)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
            try:
                with os.fdopen(fd, "wb") as handle:
                    handle.write(content)
                    handle.flush()
                    os.fsync(handle.fileno())
                os.replace(temp_name, path)
            except Exception:
                try:
                    os.unlink(temp_name)
                except OSError:
                    pass
                raise


def apply_plan(root, contract, plan, expected_hash):
    changes, plan_hash = validate_plan(root, contract, plan, expected_hash)
    keys = [change["key"] for change in changes]
    if state_fingerprint(root, contract, keys) != plan["state_fingerprint"]:
        return {"ok": False, "code": 3, "error": "stale_plan", "message": "native configuration changed; prepare again"}
    snapshots = capture_snapshots(root, contract, changes)
    artifacts = []
    try:
        for change in changes:
            _, field = field_by_key(contract, change["key"])
            path = write_native(root, field, change["to"])
            artifacts.append({"path": path, "action": "updated"})
        verification = []
        for change in changes:
            _, field = field_by_key(contract, change["key"])
            observed, exists, source = read_native(root, field)
            verified = exists and coerce(field, observed) == change["to"]
            verification.append({"key": change["key"], "verified": verified, "source": source})
        if not all(item["verified"] for item in verification):
            raise RuntimeError("post-write verification failed")
        return {"ok": True, "code": 0, "plan_hash": plan_hash, "verification": verification, "artifacts": artifacts}
    except Exception as exc:
        restore_snapshots(snapshots)
        return {"ok": False, "code": 6, "error": "apply_failed_rolled_back", "message": str(exc), "artifacts": artifacts, "rolled_back": True}


def normalize_argv(argv):
    values = list(sys.argv[1:] if argv is None else argv)
    values = [value for value in values if value != "--json"]
    if "config" in values:
        index = values.index("config")
        following = values[index + 1] if index + 1 < len(values) else None
        if following is None or following.startswith("--"):
            values.insert(index + 1, "wizard")
        elif following not in CONFIG_COMMANDS:
            values.insert(index + 1, "wizard")
    return values


def build_parser():
    parser = argparse.ArgumentParser(description="Standardized configuration facade for __APP_COMMAND__.")
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("--contract", type=Path, default=None)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("version")
    sub.add_parser("self-check")
    sub.add_parser("capabilities")
    setup = sub.add_parser("setup")
    setup.add_argument("--quick", action="store_true")
    setup.add_argument("--reconfigure", action="store_true")
    config = sub.add_parser("config")
    cs = config.add_subparsers(dest="config_command", required=True)
    wizard = cs.add_parser("wizard")
    wizard.add_argument("module", nargs="?")
    wizard.add_argument("--quick", action="store_true")
    cs.add_parser("modules")
    describe = cs.add_parser("describe"); describe.add_argument("target")
    get = cs.add_parser("get"); get.add_argument("key")
    show = cs.add_parser("show"); show.add_argument("module", nargs="?")
    validate = cs.add_parser("validate"); validate.add_argument("module", nargs="?")
    cs.add_parser("capabilities")
    cs.add_parser("coverage")
    context = cs.add_parser("agent-context"); context.add_argument("--all", action="store_true", required=True)
    prepare = cs.add_parser("prepare-change"); prepare.add_argument("--set", action="append", default=[], dest="sets"); prepare.add_argument("--file", type=Path); prepare.add_argument("--output", type=Path)
    apply = cs.add_parser("apply-plan"); apply.add_argument("--plan-file", required=True, type=Path); apply.add_argument("--expect-hash", required=True); apply.add_argument("--confirm", action="store_true", required=True)
    set_cmd = cs.add_parser("set"); set_cmd.add_argument("key"); set_cmd.add_argument("value"); set_cmd.add_argument("--dry-run", action="store_true"); set_cmd.add_argument("--confirm", action="store_true")
    unset = cs.add_parser("unset"); unset.add_argument("key"); unset.add_argument("--dry-run", action="store_true"); unset.add_argument("--confirm", action="store_true")
    secret = cs.add_parser("secret"); ss = secret.add_subparsers(dest="secret_command", required=True); secret_set = ss.add_parser("set"); secret_set.add_argument("key"); secret_set.add_argument("--stdin", action="store_true", required=True); secret_set.add_argument("--confirm", action="store_true", required=True)
    return parser


def interactive_wizard(root, contract, *, module=None, quick=False):
    if not sys.stdin.isatty():
        emit("config.wizard", status="failure", errors=[{"code": "interactive_terminal_required", "message": "wizard requires a TTY; use prepare-change for agent/non-interactive operation"}])
        return 4
    selected = []
    module_names = {item.get("name") for item in contract.get("modules", [])}
    if module and module not in module_names:
        raise ValueError(f"unknown module: {module}")
    for owner, field in fields(contract):
        if module and owner.get("name") != module:
            continue
        if quick and field.get("setup_level") != "minimal":
            continue
        if not field.get("writable") or field.get("secret"):
            continue
        current, exists, _ = read_native(root, field)
        print(f"\n{field['key']} — {field.get('description', '')}")
        print(f"Current: {current if exists else '<unset>'}")
        raw = input("New value (blank keeps current): ").strip()
        if raw:
            value = coerce(field, raw)
            validate_value(field, value)
            selected.append((field["key"], raw))
    if not selected:
        emit("config.wizard", result={"changed": False, "message": "no changes selected"})
        return 0
    plan = build_plan(root, contract, selected)
    print("\nProposed changes:")
    for change in plan["changes"]:
        print(f"- {change['key']}: {change['from']} -> {change['to']}")
    if input("Apply these changes? [y/N]: ").strip().lower() not in {"y", "yes"}:
        emit("config.wizard", result={"changed": False, "plan_hash": plan["plan_hash"]}, warnings=["cancelled by user"])
        return 0
    result = apply_plan(root, contract, plan, plan["plan_hash"])
    if not result["ok"]:
        emit("config.wizard", status="failure", changed=bool(result.get("artifacts")), result=result, errors=[{"code": result["error"], "message": result["message"]}])
        return result["code"]
    emit("config.wizard", changed=True, result=result, artifacts=result["artifacts"])
    return 0


def main(argv=None):
    args = build_parser().parse_args(normalize_argv(argv))
    root = args.root.resolve()
    contract_path = args.contract or (root / DEFAULT_CONTRACT)
    try:
        contract = load_contract(contract_path)
        if args.command == "version":
            emit("version", result={"version": CLI_VERSION}); return 0
        if args.command == "self-check":
            emit("self-check", result={"contract": str(contract_path), "contract_exists": contract_path.exists(), "root": str(root)}); return 0
        if args.command == "capabilities":
            emit("capabilities", result={"commands": ["setup", "config", "config modules", "config describe", "config get", "config show", "config set", "config unset", "config validate", "config prepare-change", "config apply-plan", "config agent-context"], "machine_output": "json"}); return 0
        if args.command == "setup":
            return interactive_wizard(root, contract, quick=args.quick)
        cmd = args.config_command
        if cmd == "wizard":
            return interactive_wizard(root, contract, module=args.module, quick=args.quick)
        if cmd == "modules":
            emit("config.modules", result={"modules": [{"name": m["name"], "description": m.get("description"), "fields": len(m.get("fields", []))} for m in contract.get("modules", [])]}); return 0
        if cmd == "describe":
            for module in contract.get("modules", []):
                if module.get("name") == args.target:
                    emit("config.describe", result=module); return 0
            _, field = field_by_key(contract, args.target); emit("config.describe", result=field); return 0
        if cmd == "get":
            _, field = field_by_key(contract, args.key); value, exists, source = read_native(root, field)
            emit("config.get", result={"key": args.key, "exists": exists, "value": "<redacted>" if field.get("secret") and exists else value, "source": source}); return 0
        if cmd == "show":
            values = []
            for module, field in fields(contract):
                if args.module and module.get("name") != args.module: continue
                value, exists, source = read_native(root, field)
                values.append({"key": field["key"], "exists": exists, "value": "<redacted>" if field.get("secret") and exists else value, "source": source})
            emit("config.show", result={"values": values}); return 0
        if cmd == "validate":
            errors = []
            for module, field in fields(contract):
                if args.module and module.get("name") != args.module: continue
                value, exists, _ = read_native(root, field)
                if field.get("required") and not exists: errors.append({"key": field["key"], "error": "required value missing"})
                if exists and not field.get("secret"):
                    try: validate_value(field, coerce(field, value))
                    except Exception as exc: errors.append({"key": field["key"], "error": str(exc)})
            emit("config.validate", status="failure" if errors else "success", result={"valid": not errors}, errors=errors); return 3 if errors else 0
        if cmd == "capabilities":
            emit("config.capabilities", result={"contract_schema": contract.get("schema_version"), "fields": [f["key"] for _, f in fields(contract)], "machine_output": "json"}); return 0
        if cmd == "coverage":
            managed = list(fields(contract)); emit("config.coverage", result={"managed_fields": len(managed), "status": "complete_for_contract", "note": "candidate dispositions are documented outside the runtime contract"}); return 0
        if cmd == "agent-context":
            emit("config.agent-context", result={"authoritative_for_managed_surface": True, "search_authoritative": False, "contract": contract}); return 0
        if cmd == "prepare-change":
            assignments = parse_assignments(args.sets)
            if args.file:
                request = json.loads(args.file.read_text(encoding="utf-8"))
                for change in request.get("changes", []):
                    assignments.append((change["key"], json.dumps(change["value"]) if isinstance(change["value"], (dict, list, bool)) else str(change["value"])))
            if not assignments:
                raise ValueError("prepare-change requires --set or --file")
            plan = build_plan(root, contract, assignments)
            if args.output: atomic_write(args.output, json.dumps(plan, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
            emit("config.prepare-change", result=plan, artifacts=[{"path": str(args.output), "action": "created"}] if args.output else []); return 0
        if cmd == "apply-plan":
            plan = json.loads(args.plan_file.read_text(encoding="utf-8"))
            result = apply_plan(root, contract, plan, args.expect_hash)
            if not result["ok"]:
                emit("config.apply-plan", status="failure", changed=bool(result.get("artifacts")), result=result, artifacts=result.get("artifacts"), errors=[{"code": result["error"], "message": result["message"]}]); return result["code"]
            emit("config.apply-plan", changed=True, result=result, artifacts=result["artifacts"]); return 0
        if cmd == "set":
            plan = build_plan(root, contract, [(args.key, args.value)])
            if args.dry_run or not args.confirm:
                emit("config.set", result=plan, warnings=[] if args.dry_run else ["not applied: pass --confirm"]); return 0
            result = apply_plan(root, contract, plan, plan["plan_hash"])
            if not result["ok"]:
                emit("config.set", status="failure", changed=bool(result.get("artifacts")), result=result, artifacts=result.get("artifacts"), errors=[{"code": result["error"], "message": result["message"]}]); return result["code"]
            emit("config.set", changed=True, result=result, artifacts=result["artifacts"]); return 0
        if cmd == "unset":
            _, field = field_by_key(contract, args.key)
            if not field.get("writable"): raise ValueError(f"field is read-only: {args.key}")
            if field.get("secret"): raise ValueError(f"secret field requires the native secret provider")
            if args.dry_run or not args.confirm:
                emit("config.unset", result={"key": args.key, "would_unset": True}, warnings=[] if args.dry_run else ["not applied: pass --confirm"]); return 0
            snapshots = capture_snapshots(root, contract, [{"key": args.key}])
            try:
                path = write_native(root, field, unset=True)
                _, exists, source = read_native(root, field)
                if exists:
                    raise RuntimeError("post-unset verification failed")
            except Exception as exc:
                restore_snapshots(snapshots)
                emit("config.unset", status="failure", changed=True, result={"key": args.key, "verified": False, "rolled_back": True}, errors=[{"code": "unset_failed_rolled_back", "message": str(exc)}]); return 6
            emit("config.unset", changed=True, result={"key": args.key, "verified": True, "source": source}, artifacts=[{"path": path, "action": "updated"}]); return 0
        if cmd == "secret":
            _, field = field_by_key(contract, args.key)
            if not field.get("secret"): raise ValueError(f"field is not secret: {args.key}")
            if not field.get("writable"): raise ValueError(f"field is read-only: {args.key}")
            raw = sys.stdin.read().rstrip("\r\n")
            value = coerce(field, raw); validate_value(field, value)
            snapshots = capture_snapshots(root, contract, [{"key": args.key}])
            try:
                path = write_native(root, field, value)
                observed, exists, _ = read_native(root, field)
                if not exists or coerce(field, observed) != value:
                    raise RuntimeError("post-write verification failed")
            except Exception as exc:
                restore_snapshots(snapshots)
                emit("config.secret.set", status="failure", changed=True, result={"key": args.key, "stored": False, "value": "<redacted>", "rolled_back": True}, errors=[{"code": "secret_write_failed_rolled_back", "message": str(exc)}]); return 6
            emit("config.secret.set", changed=True, result={"key": args.key, "stored": True, "verified": True, "value": "<redacted>"}, artifacts=[{"path": path, "action": "updated"}]); return 0
        raise ValueError(f"unsupported command: {cmd}")
    except KeyError as exc:
        emit("error", status="failure", errors=[{"code": "unknown_field", "message": str(exc)}]); return 2
    except Exception as exc:
        emit("error", status="failure", errors=[{"message": str(exc)}]); return 1


if __name__ == "__main__":
    raise SystemExit(main())
