{
  "schema_version": 1,
  "profile_version": "1.0.0",
  "repository": "coferlandia/secretarIA",
  "documentation": [
    "AGENTS.md",
    "docs/development/development-workflow.md",
    "docs/development/hotfix-lane.md",
    "docs/v1.0/FAST-CI.md"
  ],
  "local": {
    "working_directory": ".",
    "qualification_commands": [
      {"id": "canonical", "command": "bash scripts/validate-all.sh", "purpose": "repository canonical complete local qualification"}
    ],
    "required_services": ["repository-defined test services"],
    "environment": []
  },
  "github": {
    "submission": {"mode": "existing-pr-events", "workflow": ".github/workflows/fast-ci.yml"},
    "gates": [
      {"id": "final-gate", "kind": "workflow", "workflow": ".github/workflows/fast-ci.yml", "allowed_conclusions": ["success"]}
    ],
    "merge_group": {"supported": true, "authoritative_when_present": true}
  },
  "identity": {"base_sensitive": true, "profile_sensitive": true},
  "exceptions": [
    {"id": "hotfix", "documentation": "docs/development/hotfix-lane.md", "authorization": "external"}
  ]
}
